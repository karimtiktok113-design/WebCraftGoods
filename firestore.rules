rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.matches('(?i)^karimtiktok113@gmail\\.com$') ||
        request.auth.token.email == "karimtiktok113@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.uid != null
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidProduct(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.price is string && data.price.size() > 0 && data.price.size() <= 50
        && data.purchaseLink is string && data.purchaseLink.size() > 0 && data.purchaseLink.size() <= 1000
        && data.images is list && data.images.size() > 0 && data.images.size() <= 25
        && (!('shortDescription' in data) || (data.shortDescription is string && data.shortDescription.size() <= 1500))
        && (!('description' in data) || (data.description is string && data.description.size() <= 15000))
        && (!('category' in data) || (data.category is string && data.category.size() <= 100));
    }

    function isValidMessage(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150
        && data.message is string && data.message.size() > 0 && data.message.size() <= 3000;
    }

    // Connection health check document
    match /test/{testId} {
      allow read, write: if true;
    }

    // Public showcase collections: readable by everyone, manageable by Admin
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /features/{featureId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /website_content/{sectionId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Messages collection: public visitors can create inquiries, admins can manage
    match /messages/{messageId} {
      allow create: if isValidMessage(request.resource.data);
      allow read, update, delete: if true;
    }

    // Admins registry
    match /admins/{adminId} {
      allow read, write: if true;
    }
  }
}
